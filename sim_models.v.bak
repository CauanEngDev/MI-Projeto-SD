    end
endmodule

module palette_ram (
    input wire clock, input wire [8:0] data,
    input wire [8:0] rdaddress, input wire [8:0] wraddress, input wire wren,
    output reg [8:0] q
);
    reg [8:0] mem [0:511];
    always @(posedge clock) begin
        if (wren) mem[wraddress] <= data;
        q <= mem[rdaddress];
    end
endmodule