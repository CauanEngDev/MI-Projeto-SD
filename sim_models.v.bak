// sim_models.v -- APENAS para simulação, NUNCA adicionar ao projeto Quartus de síntese

module bg_tile_ram (
    input wire clock, input wire [7:0] data,
    input wire [10:0] rdaddress, input wire [10:0] wraddress, input wire wren,
    output reg [7:0] q
);
    reg [7:0] mem [0:1199];
    always @(posedge clock) begin
        if (wren) mem[wraddress] <= data;
        q <= mem[rdaddress];
    end
endmodule

module bg_tile_pattern_ram (
    input wire clock, input wire [7:0] data,
    input wire [13:0] rdaddress, input wire [13:0] wraddress, input wire wren,
    output reg [7:0] q
);
    reg [7:0] mem [0:16383];
    always @(posedge clock) begin
        if (wren) mem[wraddress] <= data;
        q <= mem[rdaddress];
    end
endmodule

module sprite_attribute_ram (
    input wire clock, input wire [31:0] data,
